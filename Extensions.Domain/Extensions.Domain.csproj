<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <PackageId>Extensions.Domain</PackageId>
    <Version>1.0.8</Version>
    <Authors>JanKrajewskiIT</Authors>
    <Company>Extensions</Company>
    <PackageDescription>Domain entities, abstractions and exceptions for clean architecture.</PackageDescription>
    <RepositoryUrl>https://github.com/JanKrajewskiIT/extensions</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <Deterministic>true</Deterministic>
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
  </PropertyGroup>
</Project>
